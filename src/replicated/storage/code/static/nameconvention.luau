--[=[
	Некоторые поля систематически стандартизированы, и могут быть проверены самим кодом на подходящие
	к его условиям стандарты для той или иной работы. Это может быть использовано, например, для
	автоматического вывода всех доступных вариаций свойств и полей объекта в качестве атрибутов
]=]

const nameconvention = {}

--[=[
    Приставка `get` к каждой функции определяет, что данная функция это геттер-метод
    самого объекта и его поля/свойства, либо геттер-функция с какой-то другой ролью

    Так или иначе, от функции ожидается, что первым аргументом она либо принимает `self`,
    либо ничего не принимает для получения значения

    Проверка на принадлежность определенного типа объектов осуществляется через проверку на
    наличие в имени геттера `namefield` имени класса, обступленного с двух сторон `_`, или только
    слева самого слова, если это конец строки, по примеру:

    `:get_object() : object`

    Так как в имени указано, что принимается `object.class`, значит и аргумент для выдачи `object.class`
]=]
nameconvention.getter = "get_" :: "get_"

--[=[
    Приставка `set` к каждой функции определяет, что данная функция это сеттер-метод
    самого объекта и его поля/свойства, но никак не сеттер-функция

    От функции всегда ожидается, что первым аргументом она принимает `self`

    Проверка на принадлежность определенного типа объектов осуществляется через проверку на
    наличие в имени сеттера `namefield` имени класса, обступленного с двух сторон `_`, или только
    слева самого слова, если это конец строки, по примеру:

    `:set_object(arg: object)`

    Так как в имени указано, что принимается `object.class`, значит и аргумент для передачи `object.class`
]=]
nameconvention.setter = "set_" :: "set_"

export type expected_field = typeof(nameconvention.getter) | typeof(nameconvention.setter)

--[=[
    Проверяет, является ли это поле expected-функцией
]=]
function nameconvention.is_field_expected(expected: expected_field, name: string): boolean
    return name:sub(1, #expected) == expected
end

--[=[
    Проверяет, указан ли в этом поле ожидаемый `return_type`, то есть поле содержит в
    себе указанный по соглашению наименований тип данных

    __Не передавайте в эту функцию декораторы с нижним подчеркиванием виде `_alpha` и т.п,
    так как это ставится автоматически__
]=]
function nameconvention.is_field_with_return_type(return_type: string, name: string): boolean
    const that_return_type = "_" .. return_type
    return (name:sub(-#that_return_type) == return_type) or name:find(that_return_type .. "_", 1, true) or false
end

--[=[
    Проверяет, указан ли в этом поле ожидаемый декоратор

    Декоратор используется как однофиксированный тег-опознаватель. __Не передавайте в
    эту функцию декораторы с нижним подчеркиванием виде `_alpha` и т.п, так как это
    ставится автоматически__
]=]
function nameconvention.is_field_with_decorator(decorator: string, name: string): boolean
    const that_decorator = "_" .. decorator
    return name:sub(-#that_decorator) == that_decorator or false
end

return table.freeze(nameconvention)