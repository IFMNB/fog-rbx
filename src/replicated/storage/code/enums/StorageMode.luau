const enum = require("@game/ReplicatedStorage/code/enum")
const struct = {__index = enum}
setmetatable(struct, struct)

--[=[
    Таблица зарегистрированная для этого экземпляра является
    ленивой, и она отсеивает ленивые ключи

    Конкретно те, которые GC может очистить из-за их ссылочной
    природы
]=]
struct.LazyKeys = enum.new()

--[=[
    Таблица зарегистрированная для этого экземпляра является
    ленивой, и она отсеивает ленивые значения

    Конкретно те, которые GC может очистить из-за их ссылочной
    природы
]=]
struct.LazyValues = enum.new()

--[=[
    Таблица зарегистрированная для этого экземпляра является
    ленивой, и она отсеивает ленивые ключи и значения

    Конкретно те, которые GC может очистить из-за их ссылочной
    природы
]=]
struct.LazyAll = enum.new()

--[=[
    Таблица зарегистрированная для этого экземпляра является
    сильной, и она не позволит ключам и значениям внутри нее
    исчезнуть без прямых манипуляций с ней
]=]
struct.Strong = enum.new()

return table.freeze(struct)