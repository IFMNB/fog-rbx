{
  "name": "Untilted",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
        "$path": "src/replicated/storage",
        
        "dependency": {
          "$path": "Packages"
        }
    },

    "ReplicatedFirst": {
      "$path": "src/replicated/first"
    },

    "ServerScriptService": {
        "$path": "src/server/service"
        
    },

    "ServerStorage": {
      "$path": "src/server/storage"
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "$path": "src/client/on_player"
      },

      "StarterCharacterScripts": {
        "$path": "src/client/on_character"
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
      
    },

    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "Voxel"
      }
    },
    
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}